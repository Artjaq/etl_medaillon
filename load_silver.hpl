  <transform>
    <name>Read_Bronze_CRM_Prd</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgreSQL</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT 
  prd_id,
  prd_key,
  -- Découpage de la clé pour extraire la catégorie (ex: 'CO-RF...' donne 'CO')
  SPLIT_PART(prd_key, '-', 1) AS cat_id,
  prd_nm,
  -- Remplacement des valeurs nulles par 0
  COALESCE(prd_cost, 0) AS prd_cost,
  -- Décodage de la ligne de produit
  CASE 
    WHEN UPPER(TRIM(prd_line)) = 'M' THEN 'Mountain'
    WHEN UPPER(TRIM(prd_line)) = 'R' THEN 'Road'
    WHEN UPPER(TRIM(prd_line)) = 'T' THEN 'Touring'
    WHEN UPPER(TRIM(prd_line)) = 'S' THEN 'Standard'
    ELSE 'n/a'
  END AS prd_line,
  prd_start_dt,
  prd_end_dt,
  CURRENT_TIMESTAMP AS dwh_create_date
FROM bronze.crm_prd_info;</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>752</yloc>
    </GUI>
