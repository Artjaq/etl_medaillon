  <transform>
    <name>Read_Bronze_CRM_Sales</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgreSQL</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT 
  sls_ord_num,
  sls_prd_key,
  sls_cust_id,
  
  -- Conversion sécurisée : on ne convertit que si la chaîne fait exactement 8 caractères (YYYYMMDD)
  CASE WHEN LENGTH(sls_order_dt::text) = 8 THEN TO_DATE(sls_order_dt::text, 'YYYYMMDD') ELSE NULL END AS sls_order_dt,
  CASE WHEN LENGTH(sls_ship_dt::text) = 8 THEN TO_DATE(sls_ship_dt::text, 'YYYYMMDD') ELSE NULL END AS sls_ship_dt,
  CASE WHEN LENGTH(sls_due_dt::text) = 8 THEN TO_DATE(sls_due_dt::text, 'YYYYMMDD') ELSE NULL END AS sls_due_dt,
  
  sls_quantity,
  
  -- Cohérence des ventes : si 0 ou NULL, on recalcule (quantité * prix)
  CASE 
    WHEN sls_sales IS NULL OR sls_sales &lt;= 0 THEN sls_quantity * sls_price
    ELSE sls_sales 
  END AS sls_sales,
  
  -- Cohérence du prix : si 0 ou NULL, on recalcule (ventes / quantité)
  CASE 
    WHEN sls_price IS NULL OR sls_price &lt;= 0 THEN 
      CASE WHEN sls_quantity > 0 THEN sls_sales / sls_quantity ELSE 0 END
    ELSE sls_price
  END AS sls_price,
  
  CURRENT_TIMESTAMP AS dwh_create_date
FROM bronze.crm_sales_details;</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>864</yloc>
    </GUI>
