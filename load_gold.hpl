  <transform>
    <name>Read_Silver_Customers</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgreSQL</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT 
  c.cst_id AS customer_id,
  c.cst_key AS customer_key,
  c.cst_firstname AS first_name,
  c.cst_lastname AS last_name,
  c.cst_marital_status AS marital_status,
  COALESCE(e.gen, c.cst_gndr) AS gender, -- Priorité au genre ERP s'il est plus propre
  e.bdate AS birth_date,
  COALESCE(l.cntry, 'n/a') AS country,
  CURRENT_TIMESTAMP AS dwh_create_date
FROM silver.crm_cust_info c
LEFT JOIN silver.erp_cust_az12 e ON c.cst_key = REPLACE(e.cid, '-', '')
LEFT JOIN silver.erp_loc_a101 l ON c.cst_key = l.cid;</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>144</yloc>
    </GUI>
