  <transform>
    <name>Read_Silver_Products</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgreSQL</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT 
  p.prd_id AS product_id,
  p.prd_key AS product_key,
  p.prd_nm AS product_name,
  p.prd_cost AS product_cost,
  p.prd_line AS product_line,
  cat.cat AS category_name,
  cat.subcat AS subcategory_name,
  cat.maintenance AS maintenance_status,
  CURRENT_TIMESTAMP AS dwh_create_date
FROM silver.crm_prd_info p
LEFT JOIN silver.erp_px_cat_g1v2 cat 
  ON REPLACE(SUBSTRING(p.prd_key, 1, 5), '-', '_') = cat.id;</sql>
    <variables_active>N</variables_active>
